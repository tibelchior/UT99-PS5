+static UBOOL UT99Ps5ClassHasName( UObject* Obj, const TCHAR* Needle )
+{
+    if( !Obj || !Obj->GetClass() || !Needle )
+        return 0;
+    for( UClass* Cls = Obj->GetClass(); Cls; Cls = Cls->GetSuperClass() )
+    {
+        const TCHAR* ClassName = Cls->GetName();
+        if( ClassName && appStrstr( ClassName, Needle ) )
+            return 1;
+    }
+    return 0;
+}
+
+static UBOOL UT99Ps5GetBoolProp( UObject* Obj, const TCHAR* Name, UBOOL Default )
+{
+    UBoolProperty* Prop = (UBoolProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UBoolProperty::StaticClass() );
+    if( !Prop )
+        return Default;
+    return ( ( *(DWORD*)((BYTE*)Obj + Prop->Offset) & Prop->BitMask ) != 0 ) ? 1 : 0;
+}
+
+static INT UT99Ps5GetIntProp( UObject* Obj, const TCHAR* Name, INT Default )
+{
+    UIntProperty* Prop = (UIntProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UIntProperty::StaticClass() );
+    return Prop ? *(INT*)((BYTE*)Obj + Prop->Offset) : Default;
+}
+
+static UObject* UT99Ps5GetObjectProp( UObject* Obj, const TCHAR* Name )
+{
+    UObjectProperty* Prop = (UObjectProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UObjectProperty::StaticClass() );
+    return Prop ? *(UObject**)((BYTE*)Obj + Prop->Offset) : NULL;
+}
+
+static FString* UT99Ps5GetStringProp( UObject* Obj, const TCHAR* Name )
+{
+    UStrProperty* Prop = (UStrProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UStrProperty::StaticClass() );
+    return Prop ? (FString*)((BYTE*)Obj + Prop->Offset) : NULL;
+}
+
+static UBOOL UT99Ps5ObjectAlive( UObject* Obj, INT Index )
+{
+    return Obj && Index != INDEX_NONE && UObject::GetIndexedObject( Index ) == Obj
+        && !( Obj->GetFlags() & ( RF_Unreachable | RF_Destroyed ) );
+}
