+// ---- PS5 statistics overlay: the "Show Statistics" check box under "Use Dynamic Lighting" in Preferences > Video ----
+// UMenu.u is the stock package, so the check box is added to the open Video page from here: a UWindowCheckbox is
+// created on the page (UWindowDialogClientWindow.CreateControl), placed one row below the dynamic lighting box and
+// kept there; its state is read back every tick and kept in the ini (NSDLDrv.NSDLClient ShowStatistics).
+extern "C" {
+void ut_ps5_stats_set(int On);
+}
+
+struct FPs5StatsHost { UObject* Page; INT PageIndex; UObject* Check; INT CheckIndex; };
+static FPs5StatsHost GPs5StatsHosts[8];
+static INT   GPs5StatsHostCount = 0;
+static UBOOL GPs5StatsOn = 0;
+static UBOOL GPs5StatsInit = 0;
+static DOUBLE GPs5StatsScanAt = 0.0;
+
+static FLOAT* UT99Ps5FloatPropPtr( UObject* Obj, const TCHAR* Name )
+{
+    UFloatProperty* Prop = (UFloatProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UFloatProperty::StaticClass() );
+    return Prop ? (FLOAT*)((BYTE*)Obj + Prop->Offset) : NULL;
+}
+
+static void UT99Ps5SetBoolProp( UObject* Obj, const TCHAR* Name, UBOOL Value )
+{
+    UBoolProperty* Prop = (UBoolProperty*)UT99Ps5FindClassPropertyPerfA( Obj ? Obj->GetClass() : NULL, Name, UBoolProperty::StaticClass() );
+    if( !Prop )
+        return;
+    DWORD* Word = (DWORD*)((BYTE*)Obj + Prop->Offset);
+    if( Value ) *Word |= Prop->BitMask; else *Word &= ~Prop->BitMask;
+}
+
+static void UT99Ps5SetStatistics( UBOOL On )
+{
+    GPs5StatsOn = On;
+    ut_ps5_stats_set( On ? 1 : 0 );
+    if( GConfig )
+    {
+        GConfig->SetBool( TEXT("NSDLDrv.NSDLClient"), TEXT("ShowStatistics"), On );
+        GConfig->Flush( 0 );
+    }
+}
