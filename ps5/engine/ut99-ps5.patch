+// Adds the check box to a Video page that does not have it yet.
+static void UT99Ps5AddStatsCheck( UObject* Page, FPs5StatsHost& Host )
+{
+    UObject* Dyn = UT99Ps5GetObjectProp( Page, TEXT("DynamicLightsCheck") );
+    UFunction* CreateFn = Page->FindFunction( FName(TEXT("CreateControl"), FNAME_Find) );
+    if( !Dyn || !CreateFn )
+        return;
+    FLOAT* DynLeft = UT99Ps5FloatPropPtr( Dyn, TEXT("WinLeft") );
+    FLOAT* DynTop  = UT99Ps5FloatPropPtr( Dyn, TEXT("WinTop") );
+    FLOAT* DynW    = UT99Ps5FloatPropPtr( Dyn, TEXT("WinWidth") );
+    FLOAT* DynH    = UT99Ps5FloatPropPtr( Dyn, TEXT("WinHeight") );
+    if( !DynLeft || !DynTop || !DynW || !DynH )
+        return;
+    struct FCreateControlParms { UClass* ControlClass; FLOAT X; FLOAT Y; FLOAT W; FLOAT H; UObject* OwnerWindow; UObject* ReturnValue; } Parms;
+    appMemzero( &Parms, sizeof(Parms) );
+    Parms.ControlClass = Dyn->GetClass();
+    Parms.X = *DynLeft; Parms.Y = *DynTop + 25.f; Parms.W = *DynW; Parms.H = *DynH;
+    Page->ProcessEvent( CreateFn, &Parms );
+    UObject* Check = Parms.ReturnValue;
+    if( !Check )
+        return;
+    UFunction* SetTextFn = Check->FindFunction( FName(TEXT("SetText"), FNAME_Find) );
+    if( SetTextFn )
+    {
+        struct FSetTextParms { FString NewText; } TextParms;
+        TextParms.NewText = TEXT("Show Statistics");
+        Check->ProcessEvent( SetTextFn, &TextParms );
+    }
+    UFunction* SetFontFn = Check->FindFunction( FName(TEXT("SetFont"), FNAME_Find) );
+    if( SetFontFn )
+    {
+        struct FSetFontParms { INT NewFont; } FontParms;
+        FontParms.NewFont = 0;   // F_Normal
+        Check->ProcessEvent( SetFontFn, &FontParms );
+    }
+    UByteProperty* AlignDyn = (UByteProperty*)UT99Ps5FindClassPropertyPerfA( Dyn->GetClass(), TEXT("Align"), UByteProperty::StaticClass() );
+    UByteProperty* AlignNew = (UByteProperty*)UT99Ps5FindClassPropertyPerfA( Check->GetClass(), TEXT("Align"), UByteProperty::StaticClass() );
+    if( AlignDyn && AlignNew )
+        *((BYTE*)Check + AlignNew->Offset) = *((BYTE*)Dyn + AlignDyn->Offset);
+    UT99Ps5SetBoolProp( Check, TEXT("bChecked"), GPs5StatsOn );
+    // The page scrolls by its desired height: one more row.
+    if( FLOAT* Desired = UT99Ps5FloatPropPtr( Page, TEXT("DesiredHeight") ) )
+        *Desired += 25.f;
+    Host.Page = Page; Host.PageIndex = (INT)Page->GetIndex();
+    Host.Check = Check; Host.CheckIndex = (INT)Check->GetIndex();
+    debugf( NAME_Log, TEXT("PS5 statistics: check box added to the Video page") );
+}
+
+// Every tick while a menu is up: finds Video pages, keeps the check box in place and reads its state.
+static void UT99Ps5UpdateStatsCheck( UBOOL bMenu )
+{
+    if( !GPs5StatsInit )
+    {
+        GPs5StatsInit = 1;
+        UBOOL On = 0;
+        if( GConfig )
+            GConfig->GetBool( TEXT("NSDLDrv.NSDLClient"), TEXT("ShowStatistics"), On );
+        GPs5StatsOn = On;
+        ut_ps5_stats_set( On ? 1 : 0 );
+    }
+    if( !bMenu )
+        return;
+    // Pages that closed (or were collected) leave the list.
+    for( INT i = GPs5StatsHostCount - 1; i >= 0; --i )
+        if( !UT99Ps5ObjectAlive( GPs5StatsHosts[i].Page, GPs5StatsHosts[i].PageIndex )
+         || !UT99Ps5ObjectAlive( GPs5StatsHosts[i].Check, GPs5StatsHosts[i].CheckIndex ) )
+            GPs5StatsHosts[i] = GPs5StatsHosts[--GPs5StatsHostCount];
+    const DOUBLE Now = appSeconds();
+    if( Now >= GPs5StatsScanAt && GPs5StatsHostCount < 8 )
+    {
+        GPs5StatsScanAt = Now + 0.4;
+        for( FObjectIterator It; It && GPs5StatsHostCount < 8; ++It )
+        {
+            UObject* Obj = *It;
+            if( !Obj || ( Obj->GetFlags() & ( RF_Unreachable | RF_Destroyed ) ) )
+                continue;
+            UClass* Cls = Obj->GetClass();
+            if( !Cls || appStricmp( Cls->GetName(), TEXT("UMenuVideoClientWindow") ) != 0 )
+                continue;
+            UBOOL Known = 0;
+            for( INT h = 0; h < GPs5StatsHostCount; ++h )
+                if( GPs5StatsHosts[h].Page == Obj ) { Known = 1; break; }
+            if( !Known && UT99Ps5GetObjectProp( Obj, TEXT("DynamicLightsCheck") ) )
+            {
+                FPs5StatsHost Host = { NULL, INDEX_NONE, NULL, INDEX_NONE };
+                UT99Ps5AddStatsCheck( Obj, Host );
+                if( Host.Check )
+                    GPs5StatsHosts[GPs5StatsHostCount++] = Host;
+            }
+        }
+    }
+    for( INT h = 0; h < GPs5StatsHostCount; ++h )
+    {
+        UObject* Page = GPs5StatsHosts[h].Page;
+        UObject* Check = GPs5StatsHosts[h].Check;
+        UObject* Dyn = UT99Ps5GetObjectProp( Page, TEXT("DynamicLightsCheck") );
+        if( Dyn )
+        {
+            FLOAT* L = UT99Ps5FloatPropPtr( Dyn, TEXT("WinLeft") );  FLOAT* T = UT99Ps5FloatPropPtr( Dyn, TEXT("WinTop") );
+            FLOAT* W = UT99Ps5FloatPropPtr( Dyn, TEXT("WinWidth") ); FLOAT* H = UT99Ps5FloatPropPtr( Dyn, TEXT("WinHeight") );
+            FLOAT* CL = UT99Ps5FloatPropPtr( Check, TEXT("WinLeft") );  FLOAT* CT = UT99Ps5FloatPropPtr( Check, TEXT("WinTop") );
+            FLOAT* CW = UT99Ps5FloatPropPtr( Check, TEXT("WinWidth") ); FLOAT* CH = UT99Ps5FloatPropPtr( Check, TEXT("WinHeight") );
+            if( L && T && W && H && CL && CT && CW && CH )
+            {
+                *CL = *L; *CT = *T + 25.f; *CW = *W; *CH = *H;
+            }
+        }
+        const UBOOL Checked = UT99Ps5GetBoolProp( Check, TEXT("bChecked"), GPs5StatsOn );
+        if( Checked != GPs5StatsOn )
+        {
+            UT99Ps5SetStatistics( Checked );
+            for( INT o = 0; o < GPs5StatsHostCount; ++o )   // other open pages follow
+                if( o != h ) UT99Ps5SetBoolProp( GPs5StatsHosts[o].Check, TEXT("bChecked"), Checked );
+            debugf( NAME_Log, TEXT("PS5 statistics: %s"), Checked ? TEXT("on") : TEXT("off") );
+        }
+    }
+}
