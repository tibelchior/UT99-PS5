+    UObject* Console = UT99Ps5WindowConsolePerfA();
+    if( !Console || !GUT99Ps5ConsoleRootPropPerfA )
+        return NULL;
+    UObject* Root = NULL;
+    appMemcpy( &Root, (BYTE*)Console + GUT99Ps5ConsoleRootPropPerfA->Offset, sizeof(Root) );
+    return Root;
+}
+
+static FLOAT UT99Ps5UWindowScalePerfA( UObject* Root )
+{
+    if( !Root || !Root->GetClass() )
+        return 1.0f;
+    if( Root->GetClass() != GUT99Ps5RootClassPerfA )
+    {
+        GUT99Ps5RootClassPerfA = Root->GetClass();
+        GUT99Ps5RootScalePropPerfA = (UFloatProperty*)UT99Ps5FindClassPropertyPerfA( Root->GetClass(), TEXT("GUIScale"), UFloatProperty::StaticClass() );
+    }
+    if( !GUT99Ps5RootScalePropPerfA )
+        return 1.0f;
+    const FLOAT Scale = *(FLOAT*)((BYTE*)Root + GUT99Ps5RootScalePropPerfA->Offset);
+    return Scale < 0.25f ? 1.0f : Scale;
+}
