+// The text field under the UWindow cursor: the edit box itself, or its UWindowEditControl (label and frame).
+static UObject* UT99Ps5EditBoxUnderCursor()
+{
+    UObject* Console = UT99Ps5WindowConsolePerfA();
+    UObject* Root = UT99Ps5UWindowRootPerfA();
+    if( !Console || !Root || !GUT99Ps5ConsoleMouseXPropPerfA || !GUT99Ps5ConsoleMouseYPropPerfA )
+        return NULL;
+    UFunction* FindWindowUnder = Root->FindFunction( FName(TEXT("FindWindowUnder"), FNAME_Find) );
+    if( !FindWindowUnder )
+        return NULL;
+    struct FFindWindowUnderParms { FLOAT X; FLOAT Y; UObject* ReturnValue; } Parms;
+    appMemzero( &Parms, sizeof(Parms) );
+    Parms.X = *(FLOAT*)((BYTE*)Console + GUT99Ps5ConsoleMouseXPropPerfA->Offset);
+    Parms.Y = *(FLOAT*)((BYTE*)Console + GUT99Ps5ConsoleMouseYPropPerfA->Offset);
+    Root->ProcessEvent( FindWindowUnder, &Parms );
+    UObject* Window = Parms.ReturnValue;
+    if( !Window )
+        return NULL;
+    if( UT99Ps5ClassHasName( Window, TEXT("EditBox") ) )
+        return Window;
+    if( UT99Ps5ClassHasName( Window, TEXT("EditControl") ) )
+    {
+        UObject* EditBox = UT99Ps5GetObjectProp( Window, TEXT("EditBox") );
+        if( EditBox && UT99Ps5ClassHasName( EditBox, TEXT("EditBox") ) )
+            return EditBox;
+    }
+    return NULL;
+}
+
+// Looks at what the pad's last A press clicked; opens the keyboard when that is a text field that can be edited.
+static void UT99Ps5OpenKeyboardForClickedField()
+{
+    UObject* EditBox = UT99Ps5EditBoxUnderCursor();
+    if( !EditBox || !UT99Ps5GetBoolProp( EditBox, TEXT("bCanEdit"), 1 ) )
+        return;
+    FString* Value = UT99Ps5GetStringProp( EditBox, TEXT("Value") );
+    INT MaxLength = UT99Ps5GetIntProp( EditBox, TEXT("MaxLength"), 0 );
+    GUT99Ps5KbTarget = EditBox;
+    GUT99Ps5KbTargetIndex = (INT)EditBox->GetIndex();
+    for( INT i = 0; i < SDL_CONTROLLER_AXIS_MAX; ++i )
+        GPs5Axis[i] = 0.0f;           // the sticks drive the keyboard now, not the menu cursor
+    ut_ps5_kb_open( Value ? TCHAR_TO_ANSI( **Value ) : "", MaxLength > 0 ? (unsigned)MaxLength : 0u );
+    debugf( NAME_Log, TEXT("PS5 keyboard: opened for %s (max %d)"), EditBox->GetClass()->GetName(), MaxLength );
+}
+
+// Replaces the field's text with what the keyboard returned (UWindowEditBox.Clear, then Insert per character).
+static void UT99Ps5TypeIntoField( const char* Text )
+{
+    UObject* EditBox = UT99Ps5ObjectAlive( GUT99Ps5KbTarget, GUT99Ps5KbTargetIndex ) ? GUT99Ps5KbTarget : NULL;
+    GUT99Ps5KbTarget = NULL;
+    GUT99Ps5KbTargetIndex = INDEX_NONE;
+    if( !EditBox )
+        return;
+    UFunction* ClearFn = EditBox->FindFunction( FName(TEXT("Clear"), FNAME_Find) );
+    UFunction* InsertFn = EditBox->FindFunction( FName(TEXT("Insert"), FNAME_Find) );
+    if( !ClearFn || !InsertFn )
+        return;
+    EditBox->ProcessEvent( ClearFn, NULL );
+    const UBOOL bNumericOnly = UT99Ps5GetBoolProp( EditBox, TEXT("bNumericOnly"), 0 );
+    const UBOOL bNumericFloat = UT99Ps5GetBoolProp( EditBox, TEXT("bNumericFloat"), 0 );
+    for( const char* C = Text; *C; ++C )
+    {
+        if( bNumericOnly && !( ( *C >= '0' && *C <= '9' ) || ( *C == '.' && bNumericFloat ) ) )
+            continue;
+        struct FInsertParms { BYTE C; DWORD ReturnValue; } Parms;
+        Parms.C = (BYTE)*C;
+        Parms.ReturnValue = 0;
+        EditBox->ProcessEvent( InsertFn, &Parms );
+    }
+    debugf( NAME_Log, TEXT("PS5 keyboard: typed %d characters"), (INT)appStrlen( ANSI_TO_TCHAR( Text ) ) );
+}
