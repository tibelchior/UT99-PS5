+static UProperty* UT99Ps5FindClassPropertyPerfA( UClass* Class, const TCHAR* Name, UClass* PropClass )
+{
+    if( !Class || !Name )
+        return NULL;
+    for( TFieldIterator<UProperty> It( Class ); It; ++It )
+    {
+        UProperty* Prop = *It;
+        if( Prop && appStricmp( Prop->GetName(), Name ) == 0 && Prop->IsA( PropClass ) )
+            return Prop;
+    }
+    return NULL;
+}
+
+static UObject* UT99Ps5WindowConsolePerfA()
+{
+    UViewport* Viewport = GUT99Ps5MenuViewportPerfA;
+    UObject* Console = Viewport ? (UObject*)Viewport->Console : NULL;
+    if( !Console || !Console->GetClass() )
+        return NULL;
+
+    UClass* Class = Console->GetClass();
+    if( Class != GUT99Ps5ConsoleClassPerfA )
+    {
+        GUT99Ps5ConsoleClassPerfA = Class;
+        GUT99Ps5ConsoleIsWindowPerfA = 0;
+        for( UClass* Cls = Class; Cls; Cls = Cls->GetSuperClass() )
+        {
+            const TCHAR* ClassName = Cls->GetName();
+            if( ClassName && appStrstr( ClassName, TEXT("WindowConsole") ) )
+            {
+                GUT99Ps5ConsoleIsWindowPerfA = 1;
+                break;
+            }
+        }
+        GUT99Ps5ConsoleRootPropPerfA = (UObjectProperty*)UT99Ps5FindClassPropertyPerfA( Class, TEXT("Root"), UObjectProperty::StaticClass() );
+        GUT99Ps5ConsoleMouseXPropPerfA = (UFloatProperty*)UT99Ps5FindClassPropertyPerfA( Class, TEXT("MouseX"), UFloatProperty::StaticClass() );
+        GUT99Ps5ConsoleMouseYPropPerfA = (UFloatProperty*)UT99Ps5FindClassPropertyPerfA( Class, TEXT("MouseY"), UFloatProperty::StaticClass() );
+    }
+    return GUT99Ps5ConsoleIsWindowPerfA ? Console : NULL;
+}
+
+static UObject* UT99Ps5UWindowRootPerfA()
